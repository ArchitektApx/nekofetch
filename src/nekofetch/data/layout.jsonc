// nekofetch layout: a regular fastfetch config.
// Copy it to ~/.config/nekofetch/layout.jsonc to make it your own.
// Rows fastfetch cannot build itself come from nekofetch as $NEKO_* variables:
//   NEKO_PACKAGES NEKO_TOOLING NEKO_TERMINAL NEKO_LOCALE NEKO_WEATHER NEKO_SAYS
// An empty variable hides its row.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // type and source come from nekofetch; width and height too, for image protocols
    "padding": {
      "top": 2,
      "right": 3
    },
    "printRemaining": false
  },
  "display": {
    "separator": "│ ",
    "color": {
      "separator": "38;2;98;114;164",
      "keys": "default"
    },
    "key": {
      "type": "string"
    },
    "size": {
      "ndigits": 0
    },
    "percent": {
      "type": [
        "bar",
        "num",
        "bar-monochrome"
      ],
      "green": 50,
      "yellow": 80,
      "color": {
        "green": "38;2;80;250;123",
        "yellow": "38;2;241;250;140",
        "red": "38;2;255;85;85"
      }
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "━"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "color": {
        "total": "38;2;53;55;74"
      },
      "width": 10
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;189;147;249}{#1;48;2;189;147;249;38;2;10;10;10}󰌢 system{#0;38;2;189;147;249}{#}"
    },
    {
      "key": "   OS       ",
      "keyColor": "38;2;189;147;249",
      "type": "os",
      "format": "{pretty-name}"
    },
    {
      "key": "  󰌢 Machine  ",
      "keyColor": "38;2;189;147;249",
      "type": "host",
      "format": "{name}"
    },
    {
      "key": "   Packages ",
      "keyColor": "38;2;189;147;249",
      "type": "command",
      "text": "printf %s \"$NEKO_PACKAGES\""
    },
    {
      "key": "   Tooling  ",
      "keyColor": "38;2;189;147;249",
      "type": "command",
      "text": "printf %s \"$NEKO_TOOLING\""
    },
    {
      "key": "   Shell    ",
      "keyColor": "38;2;189;147;249",
      "type": "shell",
      "format": "{pretty-name} {version}"
    },
    {
      "key": "   Terminal ",
      "keyColor": "38;2;189;147;249",
      "type": "command",
      "text": "printf %s \"$NEKO_TERMINAL\""
    },
    {
      "key": "  󰗊 Locale   ",
      "keyColor": "38;2;189;147;249",
      "type": "command",
      "text": "printf %s \"$NEKO_LOCALE\""
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;255;121;198}{#1;48;2;255;121;198;38;2;10;10;10}󰻠 hardware{#0;38;2;255;121;198}{#}"
    },
    {
      "key": "  󰻠 CPU      ",
      "keyColor": "38;2;255;121;198",
      "type": "cpu",
      "format": "{name} {#38;2;98;114;164}{?core-types}{core-types} {?}{?freq-max}@ {freq-max}{?}"
    },
    {
      "key": "  󰑭 Memory   ",
      "keyColor": "38;2;255;121;198",
      "type": "memory",
      "format": "{percentage-bar} {percentage} {#38;2;98;114;164}{used} / {total}"
    },
    {
      "key": "  󰋊 Disk     ",
      "keyColor": "38;2;255;121;198",
      "type": "disk",
      "folders": "/",
      "format": "{size-percentage-bar} {size-percentage} {#38;2;98;114;164}{size-used} / {size-total}"
    },
    {
      "key": "  󰁹 Battery  ",
      "keyColor": "38;2;255;121;198",
      "type": "battery",
      "format": "{capacity-bar} {capacity} {#38;2;98;114;164}{status}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;139;233;253}{#1;48;2;139;233;253;38;2;10;10;10}󰥔 today{#0;38;2;139;233;253}{#}"
    },
    {
      "key": "  󰅐 Uptime   ",
      "keyColor": "38;2;139;233;253",
      "type": "uptime"
    },
    {
      "key": "  󰖐 Weather  ",
      "keyColor": "38;2;139;233;253",
      "type": "command",
      "text": "printf %s \"$NEKO_WEATHER\""
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;255;85;85}█{#38;2;255;184;108}█{#38;2;241;250;140}█{#38;2;80;250;123}█{#38;2;139;233;253}█{#38;2;189;147;249}█{#38;2;255;121;198}█{#}"
    },
    {
      "type": "command",
      "key": " ",
      "text": "printf %s \"$NEKO_SAYS\""
    }
  ]
}
